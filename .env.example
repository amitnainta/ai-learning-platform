# Copy this file to .env.local for local development (never commit a real .env*).
# See docs/architecture/infrastructure.md for the reasoning behind each provider.

# --- Database (Neon Postgres) -----------------------------------------------
# Pooled connection (via PgBouncer) — used by the app at request time.
# Get this from the Neon project dashboard > Connection Details > "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"

# Direct (unpooled) connection — required by Prisma Migrate.
# Get this from the Neon project dashboard > Connection Details > "Direct connection".
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Error tracking / performance (Sentry) ----------------------------------
# Server-side DSN. Leave unset locally; Sentry init becomes a no-op when absent.
SENTRY_DSN=""
# Client-side DSN (must be prefixed NEXT_PUBLIC_ to be exposed to the browser bundle).
NEXT_PUBLIC_SENTRY_DSN=""

# --- App ---------------------------------------------------------------------
NODE_ENV="development"
# Public base URL of this deployment, used for absolute links/canonical URLs.
APP_URL="http://localhost:3000"

# --- Auth (Better Auth) ------------------------------------------------------
# Session/CSRF signing secret. Generate with: openssl rand -base64 32
# Required (min 32 chars) — see docs/runbooks/provisioning-checklist.md.
BETTER_AUTH_SECRET=""
# Base URL Better Auth uses for callback/action links. Optional — defaults to
# APP_URL when unset; only set this if the auth server lives at a different
# origin than APP_URL.
BETTER_AUTH_URL=""

# --- Transactional email (Resend) --------------------------------------------
# Optional locally: without this, mail falls back to the console transport
# (or MAIL_TRANSPORT=file for e2e) and nothing crashes — see
# src/lib/mail/mailer.ts. Required in production for password reset to be
# usable by real users.
RESEND_API_KEY=""
# "From" address for transactional email. Must be on a Resend-verified
# sending domain in production.
EMAIL_FROM="no-reply@localhost"
# Force a specific mail transport instead of the resend/console default
# selection: "resend" | "console" | "file". "file" is used by Playwright e2e
# so tests can read the action link from a gitignored .mail-outbox/ directory
# without a real mail provider.
MAIL_TRANSPORT=""
