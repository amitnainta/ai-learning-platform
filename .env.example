# Copy this file to .env.local for local development (never commit a real .env*).
# See docs/architecture/infrastructure.md for the reasoning behind each provider.

# --- Database (Neon Postgres) -----------------------------------------------
# Pooled connection (via PgBouncer) — used by the app at request time.
# Get this from the Neon project dashboard > Connection Details > "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true"

# Direct (unpooled) connection — required by Prisma Migrate.
# Get this from the Neon project dashboard > Connection Details > "Direct connection".
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Error tracking / performance (Sentry) ----------------------------------
# Server-side DSN. Leave unset locally; Sentry init becomes a no-op when absent.
SENTRY_DSN=""
# Client-side DSN (must be prefixed NEXT_PUBLIC_ to be exposed to the browser bundle).
NEXT_PUBLIC_SENTRY_DSN=""

# --- App ---------------------------------------------------------------------
NODE_ENV="development"
# Public base URL of this deployment, used for absolute links/canonical URLs.
APP_URL="http://localhost:3000"
