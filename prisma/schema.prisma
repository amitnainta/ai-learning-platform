// Account/auth data model (user-accounts-auth work item). Replaces the
// scaffolding `HealthCheck` stub — this is the first real product data
// model. `User`/`Session`/`Account`/`Verification`/`RateLimit` are
// generated by `npx @better-auth/cli generate` (against the configured
// Better Auth instance in src/lib/auth/index.ts) and then hand-edited here
// to add product fields, enums, cascades, and indexes: `roleArchetype`,
// `level`, `onboardingCompletedAt` on `User`, the `RoleArchetype` /
// `ProficiencyLevel` enums, `@@index([createdAt])` on `User`,
// `@@index([expiresAt])` on `Session`, and `@@unique([providerId,
// accountId])` on `Account`. Re-run the generator and re-apply these edits
// if the Better Auth config changes shape (e.g. a new plugin). No
// path/content/progress/rating/certificate model is added here — later
// work items own their own migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleArchetype {
  TECHNICAL_BUILDER
  ENGINEERING_LEADER
  EXECUTIVE_NON_TECHNICAL
  INVESTOR
  NOT_SURE_YET
}

enum ProficiencyLevel {
  ZERO_KNOWLEDGE
  INTERMEDIATE
  ADVANCED
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Product fields (FR-ACC-004/005/006/007, NFR-SEC-011). Role and level
  // are nullable because a user exists between sign-up and completing
  // onboarding. `minimumAgeAcknowledgedAt` is nullable at the database
  // level (the Better Auth adapter creates the row) but is required by
  // `signUpSchema` and written atomically at creation via the
  // `user.additionalFields` entry in src/lib/auth/options.ts — the
  // nullability here is a schema artifact, not a permitted state for new
  // accounts.
  roleArchetype            RoleArchetype?
  level                    ProficiencyLevel?
  onboardingCompletedAt    DateTime?
  minimumAgeAcknowledgedAt DateTime?

  sessions      Session[]
  accounts      Account[]
  verifications Verification[]

  @@unique([email])
  @@index([createdAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Argon2id hash of the user's password (src/lib/auth/password.ts) for
  // the "email-password" providerId row. Null for OAuth provider rows
  // (FR-ACC-009, not configured at R1).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Better Auth's own `Verification` schema has no `userId` concept (see
  // node_modules/@better-auth/core/src/db/schema/verification.ts) — the
  // library only ever writes the target user's id into `value` for the
  // one flow this app uses that creates a row here (password reset;
  // `identifier` is `reset-password:<token>`, `value` is the userId — see
  // node_modules/better-auth/dist/api/routes/password.mjs). Email
  // verification tokens are signed JWTs and never hit this table, so
  // `userId` stays null for anything else. `databaseHooks.verification
  // .create.before` (src/lib/auth/options.ts) backfills this column from
  // `value` at write time so a real FK-level cascade (rather than a
  // best-effort cleanup query) removes these rows when the owning User is
  // deleted (REVIEW.md C3 — previously orphaned on account deletion).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@index([userId])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
