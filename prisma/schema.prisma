// Account/auth data model (user-accounts-auth work item). Replaces the
// scaffolding `HealthCheck` stub — this is the first real product data
// model. `User`/`Session`/`Account`/`Verification`/`RateLimit` are
// generated by `npx @better-auth/cli generate` (against the configured
// Better Auth instance in src/lib/auth/index.ts) and then hand-edited here
// to add product fields, enums, cascades, and indexes: `roleArchetype`,
// `level`, `onboardingCompletedAt` on `User`, the `RoleArchetype` /
// `ProficiencyLevel` enums, `@@index([createdAt])` on `User`,
// `@@index([expiresAt])` on `Session`, and `@@unique([providerId,
// accountId])` on `Account`. Re-run the generator and re-apply these edits
// if the Better Auth config changes shape (e.g. a new plugin). No
// path/content/progress/rating/certificate model is added here — later
// work items own their own migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleArchetype {
  TECHNICAL_BUILDER
  ENGINEERING_LEADER
  EXECUTIVE_NON_TECHNICAL
  INVESTOR
  NOT_SURE_YET
}

enum ProficiencyLevel {
  ZERO_KNOWLEDGE
  INTERMEDIATE
  ADVANCED
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Product fields (FR-ACC-004/005/006/007, NFR-SEC-011). Role and level
  // are nullable because a user exists between sign-up and completing
  // onboarding. `minimumAgeAcknowledgedAt` is nullable at the database
  // level (the Better Auth adapter creates the row) but is required by
  // `signUpSchema` and written atomically at creation via the
  // `user.additionalFields` entry in src/lib/auth/options.ts — the
  // nullability here is a schema artifact, not a permitted state for new
  // accounts.
  roleArchetype            RoleArchetype?
  level                    ProficiencyLevel?
  onboardingCompletedAt    DateTime?
  minimumAgeAcknowledgedAt DateTime?

  sessions      Session[]
  accounts      Account[]
  verifications Verification[]
  progress      Progress[]
  ratings       Rating[]
  ratingFlags   RatingFlag[]

  @@unique([email])
  @@index([createdAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Argon2id hash of the user's password (src/lib/auth/password.ts) for
  // the "email-password" providerId row. Null for OAuth provider rows
  // (FR-ACC-009, not configured at R1).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Better Auth's own `Verification` schema has no `userId` concept (see
  // node_modules/@better-auth/core/src/db/schema/verification.ts) — the
  // library only ever writes the target user's id into `value` for the
  // one flow this app uses that creates a row here (password reset;
  // `identifier` is `reset-password:<token>`, `value` is the userId — see
  // node_modules/better-auth/dist/api/routes/password.mjs). Email
  // verification tokens are signed JWTs and never hit this table, so
  // `userId` stays null for anything else. `databaseHooks.verification
  // .create.before` (src/lib/auth/options.ts) backfills this column from
  // `value` at write time so a real FK-level cascade (rather than a
  // best-effort cleanup query) removes these rows when the owning User is
  // deleted (REVIEW.md C3 — previously orphaned on account deletion).
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@index([userId])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// -----------------------------------------------------------------------
// Learning-paths-content model (learning-paths-content work item).
//
// `RoleArchetype` and `ProficiencyLevel` (declared above, alongside `User`)
// are reused as-is from the auth item — not redeclared here. This item adds
// no column and no model to `User`/`Session`/`Account`/`Verification`/
// `RateLimit`.
//
// Deliberately absent: any `Progress`, `Rating`, `Bookmark`, or
// `Certificate` model, and any user-referencing column on a content table.
// Those are later work items' migrations. Per
// factory/work/learning-paths-content/PLAN.md decision #6, they will
// reference the stable ids created here: progress keys on
// `(userId, contentItemId)`, ratings on `Course.id`/`Path.id` — see
// docs/architecture/content.md.
// -----------------------------------------------------------------------

// FR-PATH-004 "format" axis — a closed set (see docs/content/taxonomy.md).
enum ContentFormat {
  ARTICLE
  VIDEO
  INTERACTIVE
  COURSE
  PAPER
  PODCAST
  TOOL
}

// FR-PATH-004 "source type" axis. ORIGINAL requires `body` (platform
// authored); CURATED requires `externalUrl` + `sourcePublisher` (linked,
// never rehosted — NFR-COMP-001). Enforced by the Zod import schema
// (a discriminated union in src/lib/validation/content.ts), not a database
// check constraint (decision #1 in "Prisma schema design", PLAN.md).
enum SourceType {
  ORIGINAL
  CURATED
}

// Applies to RoleProfile, Path, Course, ContentItem, GlossaryTerm. Only
// PUBLISHED renders publicly (src/lib/content/queries.ts filters on it).
enum ContentStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// FR-SEARCH-004 landing-page copy for one role archetype.
model RoleProfile {
  id      String        @id @default(cuid())
  role    RoleArchetype @unique
  slug    String        @unique
  title   String
  summary String
  // Markdown: who this is for, what you will learn.
  body    String

  status ContentStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role_profile")
}

// FR-PATH-001/002: an ordered sequence of courses for one role x level
// combination. @@unique([roleArchetype, level]) — at R1/R2 there is exactly
// one curated path per role x level (decision #5); FR-PATH-010's
// user-assembled custom paths are a separate, future `UserPath` model, not
// extra rows here.
model Path {
  id            String           @id @default(cuid())
  slug          String           @unique
  roleArchetype RoleArchetype
  level         ProficiencyLevel
  title         String
  summary       String
  // Markdown.
  description   String

  status ContentStatus @default(DRAFT)

  courses PathCourse[]
  ratings Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleArchetype, level])
  @@index([status])
  @@map("path")
}

// No duration column: estimated duration is summed from a course's items at
// read time (src/lib/content/queries.ts) so it cannot drift out of sync
// (Prisma schema design notes, PLAN.md).
model Course {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  summary     String
  // Markdown, optional.
  description String?

  status ContentStatus @default(DRAFT)

  paths   PathCourse[]
  items   CourseItem[]
  ratings Rating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("course")
}

// Ordered many-to-many join, Path -> Course. Deliberately no unique
// constraint on `position`: the importer rewrites a path's ordering
// wholesale inside one transaction, and a unique position constraint would
// trip on transient intermediate states (decision #5).
model PathCourse {
  id       String @id @default(cuid())
  pathId   String
  courseId String
  position Int

  path   Path   @relation(fields: [pathId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([pathId, courseId])
  @@index([pathId, position])
  @@map("path_course")
}

// Ordered many-to-many join, Course -> ContentItem. Same shape/rationale as
// PathCourse.
model CourseItem {
  id            String @id @default(cuid())
  courseId      String
  contentItemId String
  position      Int

  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([courseId, contentItemId])
  @@index([courseId, position])
  @@map("course_item")
}

// The atomic content unit and the stable id everything later (Progress,
// Rating, Certificate) hangs off (decision #6). `slug` is author-controlled
// and stable across imports (decision #2) — the id itself never rotates.
model ContentItem {
  id      String @id @default(cuid())
  slug    String @unique
  title   String
  summary String

  // Tagging (FR-PATH-004) — validated at import, displayed in the UI.
  roles            RoleArchetype[]
  level            ProficiencyLevel
  format           ContentFormat
  estimatedMinutes Int
  sourceType       SourceType
  topics           Topic[]

  // Original-lesson fields (SourceType.ORIGINAL). `video*` fields are all
  // optional and, per decision #4, `videoCaptionsUrl` is required whenever
  // `videoUrl` is present — enforced by the Zod import schema, not the
  // database.
  body                 String?
  videoUrl             String?
  videoCaptionsUrl     String?
  videoPosterUrl       String?
  videoDurationSeconds Int?

  // Curated fields (SourceType.CURATED) — NFR-COMP-001: linked, never
  // rehosted; publisher attribution displayed on every curated item.
  externalUrl       String?
  sourcePublisher   String?
  sourceAuthor      String?
  sourcePublishedOn DateTime?
  attributionNote   String?

  // Lifecycle (FR-PATH-007).
  status            ContentStatus @default(DRAFT)
  publishedAt       DateTime?
  retiredAt         DateTime?
  lastReviewedAt    DateTime
  reviewCadenceDays Int
  nextReviewDueAt   DateTime
  version           Int           @default(1)
  contentHash       String

  courses  CourseItem[]
  versions ContentItemVersion[]
  progress Progress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sourceType])
  @@index([level])
  @@index([nextReviewDueAt])
  @@map("content_item")
}

// Append-only version history (FR-PATH-007, decision #8). Written by the
// importer on create and on every content-hash-detected change; never
// updated or deleted.
model ContentItemVersion {
  id             String   @id @default(cuid())
  contentItemId  String
  version        Int
  contentHash    String
  // Full JSON snapshot of the item's importable fields at this version.
  // Deliberately untyped (Risks/open questions #11, PLAN.md) — a snapshot
  // must survive future schema changes without a backfill.
  snapshot       Json
  changeNote     String?
  lastReviewedAt DateTime
  createdAt      DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, version])
  @@index([contentItemId])
  @@map("content_item_version")
}

// Topics are data, not an enum (decision #9) — the open-ended taxonomy
// axis, declared in content/taxonomy.yaml. Implicit many-to-many to
// ContentItem.
model Topic {
  id          String  @id @default(cuid())
  slug        String  @unique
  label       String
  description String?

  items ContentItem[]

  @@map("topic")
}

// FR-PATH-008 contextual definitions. `shortDefinition` is capped at 200
// characters by the Zod import schema (used for the inline hover/focus
// definition); `body` is the long-form Markdown definition for the term
// page.
model GlossaryTerm {
  id              String   @id @default(cuid())
  slug            String   @unique
  term            String
  shortDefinition String
  body            String
  aliases         String[]
  relatedSlugs    String[]
  lastReviewedAt  DateTime

  status ContentStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([term])
  @@map("glossary_term")
}

// -----------------------------------------------------------------------
// Progress-tracking model (progress-tracking work item).
//
// "Not started" is deliberately the absence of a `Progress` row, not a
// third enum value (decision #2, factory/work/progress-tracking/PLAN.md) —
// materialising it for every (user, item) pair would be 500M+ meaningless
// rows at the NFR-SCALE-002 year-one target and would force the content
// importer to fan out a write per user on every new item. The read layer
// (src/lib/progress/status.ts) maps an absent row to the display value
// "NOT_STARTED".
//
// Keyed on `ContentItem.id`, never on `CourseItem.id`/`PathCourse.id`: the
// importer's `rewriteCourseOrdering()`/`rewritePathOrdering()`
// (src/lib/content/import.ts) delete and recreate those join rows on every
// course/path update, so their ids rotate on a routine content edit — a
// `Progress` row pointing at one would be orphaned. `ContentItem.id` is the
// only id in this schema that's stable across re-imports (see the
// "Verification of the learning-paths-content purely additive claim"
// section of the plan). This is also what makes FR-PATH-009 (progress
// retained across paths that share an item) true by construction: one
// content item is one row, referenced from as many paths as contain it.
//
// Deliberately absent: any `Rating`, `Certificate`, `Streak`, `Badge`, or
// `Bookmark` model, and any denormalized percentage column on `Course`,
// `Path`, or `User` — percentages and resume targets are computed at read
// time (src/lib/progress/percent.ts), the same precedent
// learning-paths-content set for course/path duration.
// -----------------------------------------------------------------------

// Two values only — "not started" is the absence of a row, not a value of
// this enum (decision #2).
enum ProgressStatus {
  IN_PROGRESS
  COMPLETE
}

// One row per (user, content item) the user has ever viewed or completed
// (decision #1: "in progress" is observed via a view, "complete" is always
// an explicit, reversible learner action — never inferred).
model Progress {
  id            String         @id @default(cuid())
  userId        String
  contentItemId String
  status        ProgressStatus @default(IN_PROGRESS)
  // Bumped by every `view` action; also the recency signal that orders the
  // dashboard's active-path list (decision #6) and the future FR-PROG-004
  // streak's activity signal.
  lastViewedAt  DateTime       @default(now())
  // Stamped once, on first completion; never moved by a re-click (decision
  // #3). Nullable — cleared by `reopen`. Authoritative for a future
  // FR-CERT certificate issuance timestamp.
  completedAt   DateTime?

  // `createdAt` doubles as "started at" — a row only ever comes into
  // existence at the moment of first view, so no separate column is needed.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, contentItemId])
  @@index([userId, lastViewedAt])
  @@index([contentItemId])
  @@map("progress")
}

// -----------------------------------------------------------------------
// Ratings-and-feedback model (ratings-and-feedback work item).
//
// One `Rating` table with two nullable target foreign keys (`courseId`,
// `pathId`), not two tables and not a polymorphic string id (decision #1,
// factory/work/ratings-and-feedback/PLAN.md). Exactly one of `courseId`/
// `pathId` must be non-null — this is enforced by a hand-written `CHECK`
// constraint (`rating_exactly_one_target`) appended by hand to this item's
// migration.sql; it is **not visible anywhere in this file**, Prisma does
// not model it, and it will neither be dropped nor regenerated by future
// `prisma migrate dev` runs. A second CHECK (`rating_stars_range`) enforces
// `stars BETWEEN 1 AND 5` at the database layer, on top of the Zod and API
// layers. Both must be carried forward by hand if migrations are ever
// squashed or regenerated (Risks #7).
//
// Aggregates (average, count) are computed at read time via a single
// `groupBy` per page (decision #6) — there is deliberately no denormalized
// `ratingSum`/`ratingCount`/`flagCount` column on `Course`, `Path`, or
// `Rating` anywhere in this schema. The decisive reason is that a
// denormalized counter would have to be kept in step with account
// deletion, which today removes a user's ratings via a database-level
// cascade with no application code involved (`progress-tracking` decision
// #9) — denormalizing here would mean weakening that already-shipped
// guarantee.
//
// `Rating.hiddenAt`/`hiddenReason` are written only by
// `scripts/moderation.ts` (`hide`/`unhide`), never by the public API
// (decision #5) — a flag records a report but never auto-hides anything.
//
// Deliberately absent: any `Certificate`, `Bookmark`, `Streak`, or
// search-index model; any aggregate/rating column on `Course`, `Path`, or
// `User`; any column on `Progress`.
// -----------------------------------------------------------------------

// `OUTDATED_OR_INCORRECT` is named after FR-RATE-007's own wording ("flagged
// as outdated/incorrect") so that R2 item has a queryable axis with no
// backfill (decision #5).
enum RatingFlagReason {
  INAPPROPRIATE
  SPAM
  OUTDATED_OR_INCORRECT
  OTHER
}

// One rating per user per course, one per user per path (decision #1).
// `stars Int` (not an enum) because it must be averaged. `feedback String?`
// — null means "rated without commenting" (decision #7); an empty string is
// never stored. See the header comment above for the two hand-written CHECK
// constraints this model relies on and does not itself express.
model Rating {
  id       String  @id @default(cuid())
  userId   String
  courseId String?
  pathId   String?

  stars    Int
  feedback String?

  // Moderation (decision #5). Written only by scripts/moderation.ts; read
  // by every public aggregate and list query, which filter `hiddenAt: null`.
  hiddenAt     DateTime?
  hiddenReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  path   Path?   @relation(fields: [pathId], references: [id], onDelete: Cascade)

  flags RatingFlag[]

  @@unique([userId, courseId])
  @@unique([userId, pathId])
  @@index([courseId])
  @@index([pathId])
  @@map("rating")
}

// One flag per user per rating (decision #5) — a table, not columns on
// `Rating`, so more than one report on the same rating is preserved rather
// than overwritten or dropped.
model RatingFlag {
  id         String           @id @default(cuid())
  ratingId   String
  userId     String
  reason     RatingFlagReason
  note       String?
  // Set by scripts/moderation.ts `hide`/`dismiss` so the queue is drainable.
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  rating Rating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ratingId, userId])
  @@index([ratingId])
  @@index([resolvedAt])
  @@map("rating_flag")
}
