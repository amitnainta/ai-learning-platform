// Stub Prisma schema — exists only to exercise the toolchain (generate,
// migrate) during scaffolding. This model is expected to be replaced or
// removed by the first real data-model work item; it does not pre-empt
// the product schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Trivial stub model used to prove `prisma generate` / `prisma migrate`
/// work end-to-end against a real Postgres instance (Neon). Not a product
/// entity.
model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}
