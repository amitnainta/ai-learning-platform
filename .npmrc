# better-auth declares optional peerDependencies on every framework/ORM
# adapter it supports (SvelteKit, Vue, Solid, Drizzle, etc.), none of which
# this project uses. npm's strict peer resolver still walks those optional
# peers' own peer ranges (e.g. @sveltejs/kit -> vite@^8) and reports an
# ERESOLVE conflict against this project's actual vite@7 (via
# @vitejs/plugin-react/vitest), even though every one of those peers is
# marked optional and none of the packages are actually installed.
# legacy-peer-deps sidesteps that specific false-positive; it does not
# change which packages get installed for this project's real dependency
# tree. See factory/work/user-accounts-auth/PLAN.md builder notes.
legacy-peer-deps=true
